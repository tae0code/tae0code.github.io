---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { projects } from '../../data/projects';
import { url } from '../../lib/paths';
---
<Base title="Selected work" active="work">
  <section class="page-intro container"><span class="eyebrow"><span class="small-line"></span> SELECTED WORK / {String(projects.length).padStart(2, '0')}</span><h1>A few things<br /><span class="serif-word">I've built<span class="accent">.</span></span></h1><div class="page-intro-bottom"><p>문제를 발견하고, 아이디어를 실험하고, 직접 만듭니다.<br />결과물 뒤에 있는 선택과 과정을 함께 기록합니다.</p><span class="mono muted">IDEA → CODE → EXPERIENCE</span></div></section>
  <section class="container project-archive" aria-label="프로젝트 목록">
    {projects.map((project, index) => <a class="work-card reveal" href={url(`work/${project.slug}/`)}><div class="work-card-art"><span class="work-card-count mono">PROJECT {String(index + 1).padStart(2, '0')}</span><div class="code-composition"><span class="mono">const space = &#123;</span><strong>make<span class="accent">()</span><br />learn<span class="accent">()</span><br /><em>repeat<span class="accent">()</span></em></strong><span class="mono">&#125;;</span></div><div class="art-corner mono">DESIGNED TO KEEP GROWING.</div><div class="art-rings" aria-hidden="true"><span></span><span></span><span></span></div></div><div class="work-card-caption"><div><span class="section-index mono">{project.category.toUpperCase()} / {project.year}</span><h2>{project.name}<span class="accent">.</span></h2><p>{project.description}</p><div class="tags">{project.technologies.map(tech => <span>{tech}</span>)}</div></div><span class="circle-plus" aria-hidden="true">+</span></div></a>)}
    <div class="next-project reveal"><Icon name="terminal" size={28} /><div><h2>The next idea starts here.</h2><p>다음 프로젝트의 이야기를 준비하고 있습니다.</p></div><span class="mono">git commit -m "keep building"</span></div>
  </section>
</Base>
