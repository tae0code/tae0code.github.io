---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import NoteRow from '../../components/NoteRow.astro';
import { publishedPosts } from '../../lib/posts';
import { url } from '../../lib/paths';
const posts = await publishedPosts();
const categories = ['All', ...new Set(posts.map((post) => post.data.category))];
---

<Base
  title="Writing"
  active="writing"
>
  <section class="page-intro container">
    <span class="eyebrow">
      <span class="small-line"></span> NOTES & THOUGHTS
    </span>
    <h1>
      Learning
      <br />
      <span class="serif-word">
        in public<span class="accent">.</span>
      </span>
    </h1>
    <div class="page-intro-bottom">
      <p>
        코드 너머의 생각, 만들며 배운 것들.
        <br />
        작은 발견을 오래 남는 기록으로 바꿉니다.
      </p>
      <a
        class="text-link mono"
        href={url('rss.xml')}
      >
        RSS FEED{' '}
        <Icon
          name="file"
          size={16}
        />
      </a>
    </div>
  </section>
  <section
    class="container writing-archive"
    aria-label="글 목록"
  >
    <div
      class="writing-controls"
      data-enhanced
      hidden
    >
      <div
        class="filter-list"
        role="group"
        aria-label="글 분류"
      >
        {categories.map((category) => (
          <button
            type="button"
            class:list={['filter-button', { selected: category === 'All' }]}
            data-filter={category}
            aria-pressed={category === 'All'}
          >
            {category === 'All' ? 'All notes' : category}
            <span>
              {category === 'All'
                ? posts.length
                : posts.filter((p) => p.data.category === category).length}
            </span>
          </button>
        ))}
      </div>
      <div class="search-box">
        <Icon
          name="search"
          size={17}
        />
        <label
          for="post-search"
          class="sr-only"
        >
          글 검색
        </label>
        <input
          id="post-search"
          type="search"
          placeholder="궁금한 주제를 검색하세요"
          autocomplete="off"
        />
        <kbd>/</kbd>
      </div>
    </div>
    <div class="archive-caption mono">
      <span
        id="result-count"
        aria-live="polite"
      >
        {posts.length} NOTES
      </span>
      <span>THINKING OUT LOUD, ONE NOTE AT A TIME.</span>
    </div>
    <div class="notes-list">
      {posts.map((post, index) => (
        <NoteRow
          post={post}
          index={index}
        />
      ))}
    </div>
    <div
      id="no-results"
      class="empty-state"
      hidden
    >
      <Icon
        name="search"
        size={32}
      />
      <h2>아직 없는 이야기네요.</h2>
      <p>다른 검색어나 분류로 찾아보세요.</p>
      <button
        type="button"
        class="button button-outline"
        id="reset-search"
      >
        전체 글 보기
      </button>
    </div>
    <p class="archive-note">
      이 공간의 첫 글들입니다. <span class="mono">STARTER NOTE</span>는 교체할 수 있는 예시
      글입니다.
    </p>
  </section>
  <script>
    const controls = document.querySelector<HTMLElement>('[data-enhanced]');
    if (controls) controls.hidden = false;
    const search = document.querySelector<HTMLInputElement>('#post-search')!;
    const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const posts = Array.from(document.querySelectorAll<HTMLElement>('[data-post]'));
    let category = 'All';
    const params = new URLSearchParams(location.search);
    search.value = params.get('q') || '';
    if (filters.some((button) => button.dataset.filter === params.get('category')))
      category = params.get('category')!;
    function update() {
      const term = search.value.trim().toLocaleLowerCase();
      let count = 0;
      posts.forEach((post) => {
        const show =
          (category === 'All' || post.dataset.category === category) &&
          (!term || post.dataset.search?.includes(term));
        post.hidden = !show;
        if (show) {
          count++;
          post.classList.add('is-visible');
        }
      });
      filters.forEach((button) => {
        const active = button.dataset.filter === category;
        button.classList.toggle('selected', active);
        button.setAttribute('aria-pressed', String(active));
      });
      document.querySelector('#result-count')!.textContent =
        `${count} ${count === 1 ? 'NOTE' : 'NOTES'}`;
      document.querySelector<HTMLElement>('#no-results')!.hidden = count > 0;
      const next = new URL(location.href);
      if (term) next.searchParams.set('q', search.value.trim());
      else next.searchParams.delete('q');
      if (category !== 'All') next.searchParams.set('category', category);
      else next.searchParams.delete('category');
      history.replaceState(null, '', next);
    }
    search.addEventListener('input', update);
    filters.forEach((button) =>
      button.addEventListener('click', () => {
        category = button.dataset.filter!;
        update();
      }),
    );
    document.querySelector('#reset-search')?.addEventListener('click', () => {
      search.value = '';
      category = 'All';
      update();
      search.focus();
    });
    document.addEventListener('keydown', (event) => {
      if (
        event.key === '/' &&
        !event.metaKey &&
        !event.ctrlKey &&
        !(
          event.target instanceof HTMLInputElement ||
          event.target instanceof HTMLTextAreaElement ||
          (event.target instanceof HTMLElement && event.target.isContentEditable)
        )
      ) {
        event.preventDefault();
        search.focus();
      }
    });
    update();
  </script>
</Base>
