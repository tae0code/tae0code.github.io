---
import Base from '../layouts/Base.astro';
import NeuralNetwork from '../components/NeuralNetwork.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
import { url } from '../lib/paths';
import { publishedPosts } from '../lib/posts';
import NoteRow from '../components/NoteRow.astro';
const posts = (await publishedPosts()).slice(0, 2);
---

<Base>
  <section class="hero container">
    <div class="hero-topline mono">
      <span>PERSONAL SPACE / VOL. 01</span>
      <span>DEVELOPER · MAKER · LIFELONG LEARNER</span>
    </div>
    <div class="hero-grid">
      <div class="hero-copy">
        <div class="eyebrow">
          <span class="small-line"></span> HELLO, WORLD. I'M {profile.name.toUpperCase()}
        </div>
        <h1>
          Ideas into
          <br />
          <span class="serif-word">
            interfaces<span class="accent">.</span>
          </span>
        </h1>
        <p class="hero-korean">{profile.tagline}</p>
        <p class="hero-description">{profile.intro}</p>
        <div class="hero-actions">
          <a
            class="button button-primary"
            href={url('work/')}
          >
            <Icon
              name="code"
              size={18}
            />
            Explore my work
          </a>
          <a
            class="button button-quiet"
            href={url('about/')}
          >
            A little about me <span class="mono">+</span>
          </a>
        </div>
      </div>
      <NeuralNetwork />
    </div>
    <div class="hero-bottom">
      <span>
        <span class="accent mono">⌘</span> Turning coffee into things that matter.
      </span>
      <a
        href="#selected-work"
        class="mono scroll-cue"
      >
        SCROLL TO EXPLORE <span aria-hidden="true">↓</span>
      </a>
    </div>
  </section>
  <div class="tech-strip">
    <div class="container">
      <span class="mono tech-label">MY TOOLBOX</span>
      {profile.skills.map((name, i) => (
        <span class="tech-item">
          <span
            class="tech-glyph"
            aria-hidden="true"
          >
            {['TS', '⚛', '⬡', 'Py', '⑂'][i] || '+'}
          </span>
          {name}
        </span>
      ))}
      <span class="mono tech-more">& always learning</span>
    </div>
  </div>
  <section
    id="selected-work"
    class="section container"
  >
    <div class="section-heading">
      <div>
        <span class="section-index mono">01 / SELECTED WORK</span>
        <h2>
          Built with intention<span class="accent">.</span>
        </h2>
        <p>아이디어가 실제로 작동하는 무언가가 되기까지.</p>
      </div>
      <a
        class="text-link"
        href={url('work/')}
      >
        프로젝트 둘러보기{' '}
        <span class="link-square">
          <Icon
            name="code"
            size={17}
          />
        </span>
      </a>
    </div>
    <a
      class="project-feature"
      href={url('work/personal-space/')}
    >
      <div class="project-visual">
        <div class="mini-browser">
          <div class="mini-toolbar">
            <i></i>
            <i></i>
            <i></i>
            <span>localhost:4321</span>
          </div>
          <div class="mini-content">
            <span class="mini-brand">
              t<span class="accent">.</span>
            </span>
            <span class="mono mini-caption">A SPACE TO MAKE & SHARE</span>
            <strong>
              Make.
              <br />
              Learn.
              <br />
              <em>Repeat.</em>
            </strong>
            <div
              class="mini-orbit"
              aria-hidden="true"
            >
              <span></span>
              <span></span>
              <span></span>
            </div>
            <span class="mini-bottom mono">PERSONAL SPACE — 2026</span>
          </div>
        </div>
        <span class="visual-label mono">DESIGN + DEVELOPMENT</span>
      </div>
      <div class="project-info">
        <div class="project-top">
          <span class="mono">001 / WEB EXPERIENCE</span>
          <span class="project-year mono">2026</span>
        </div>
        <h3>
          Personal space<span class="accent">.</span>
        </h3>
        <p>
          프로젝트, 생각, 그리고 나를 담는 공간.
          <br />
          지금 보고 있는 이 포트폴리오의 제작 노트입니다.
        </p>
        <div class="tags">
          <span>Astro</span>
          <span>TypeScript</span>
          <span>Canvas</span>
        </div>
        <span class="project-read">
          프로젝트 이야기 읽기{' '}
          <span
            class="circle-plus"
            aria-hidden="true"
          >
            +
          </span>
        </span>
      </div>
    </a>
    <div class="work-footnote mono">
      <span>MORE IDEAS ARE IN THE MAKING.</span>
      <span>좋은 다음 프로젝트를 준비하고 있습니다.</span>
    </div>
  </section>
  <section class="section container writing-preview">
    <div class="section-heading">
      <div>
        <span class="section-index mono">02 / NOTES & THOUGHTS</span>
        <h2>
          Learning in public<span class="accent">.</span>
        </h2>
        <p>배운 것은 기록하고, 기록한 것은 나눕니다.</p>
      </div>
      <a
        class="text-link"
        href={url('writing/')}
      >
        모든 글 보기{' '}
        <span class="link-square">
          <Icon
            name="file"
            size={17}
          />
        </span>
      </a>
    </div>
    <div class="notes-list">
      {posts.map((post, index) => (
        <NoteRow
          post={post}
          index={index}
        />
      ))}
    </div>
  </section>
  <section class="about-teaser container">
    <div class="about-teaser-label">
      <span class="section-index mono">03 / THE HUMAN BEHIND THE CODE</span>
      <span
        class="asterisk"
        aria-hidden="true"
      >
        ✳
      </span>
    </div>
    <div>
      <h2>
        More than
        <br />a <span class="muted">commit history.</span>
      </h2>
      <p>{profile.about}</p>
      <a
        class="text-link"
        href={url('about/')}
      >
        조금 더 알아보기{' '}
        <span class="link-square">
          <Icon
            name="spark"
            size={17}
          />
        </span>
      </a>
    </div>
  </section>
</Base>
