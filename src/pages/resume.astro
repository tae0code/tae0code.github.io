---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
import { projects } from '../data/projects';
import { url } from '../lib/paths';
const hasPdf = !!profile.resumeFile && existsSync(resolve('public', profile.resumeFile));
---
<Base title="Résumé" active="resume">
  <section class="container resume-shell"><div class="resume-toolbar"><span class="eyebrow"><span class="small-line"></span> RÉSUMÉ / WEB EDITION</span><div>{hasPdf && <a class="button button-primary" href={url(profile.resumeFile)} download><Icon name="download" size={17} />PDF 다운로드</a>}<button type="button" class="button button-outline" data-print><Icon name="file" size={17} />인쇄 · PDF로 저장</button></div></div><div class="resume-paper"><header class="resume-header"><div><span class="section-index mono">DEVELOPER & CURIOUS MAKER</span><h1>{profile.name}<span class="accent">.</span></h1><p>{profile.tagline}</p></div><div class="resume-contact">{profile.email && <a href={`mailto:${profile.email}`}>{profile.email}</a>}{profile.github && <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a>}{profile.linkedin && <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>}<span class="mono">{profile.experience.length ? 'RÉSUMÉ' : 'DRAFT / 경력 정보 업데이트 예정'}</span></div></header><div class="resume-row"><h2>Profile<span class="accent">.</span></h2><div><p>{profile.intro}</p><p>{profile.about}</p></div></div><div class="resume-row"><h2>Experience<span class="accent">.</span></h2><div>{profile.experience.length ? profile.experience.map(experience => <div class="resume-entry"><span class="mono muted">{experience.period}</span><h3>{experience.company}</h3><strong>{experience.role}</strong><p>{experience.description}</p></div>) : <div class="resume-empty"><span class="mono">THE STORY IS STILL BEING WRITTEN.</span><p>경력과 활동 내용을 정리하고 있습니다.</p></div>}</div></div><div class="resume-row"><h2>Projects<span class="accent">.</span></h2><div>{projects.map(project => <div class="resume-entry"><span class="mono muted">{project.year} / {project.role}</span><h3><a href={url(`work/${project.slug}/`)}>{project.name}</a></h3><p>{project.description}</p><div class="tags">{project.technologies.map(tech => <span>{tech}</span>)}</div></div>)}</div></div><div class="resume-row"><h2>Skills<span class="accent">.</span></h2><div><div class="large-tags resume-skills">{profile.skills.map(skill => <span>{skill}</span>)}</div><p class="resume-draft-note">기본 예시 목록 · 실제 사용 기술에 맞춰 업데이트 예정</p></div></div><div class="resume-row"><h2>Education<span class="accent">.</span></h2><div>{profile.education.length ? profile.education.map(education => <div class="resume-entry"><span class="mono muted">{education.period}</span><h3>{education.school}</h3><p>{education.degree}</p></div>) : <p class="muted">학력과 학습 이력은 곧 업데이트됩니다.</p>}</div></div><div class="resume-end mono"><span>ALWAYS LEARNING. ALWAYS BUILDING.</span><span>{profile.name}</span></div></div>{!hasPdf && <p class="resume-hint">PDF 이력서는 아직 등록되지 않았습니다. 현재 웹 이력서는 인쇄하거나 PDF로 저장할 수 있습니다.</p>}</section>
</Base>
